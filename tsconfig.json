{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"strict": true,
		"strictNullChecks": true,
		"noImplicitReturns": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"isolatedModules": true,
		"lib": ["DOM", "ESNext"],
		"types": ["svelte"],
		"allowSyntheticDefaultImports": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"paths": {
			"packages/*": ["./packages/*"],
			"src/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "src/**/*.svelte"]
}
