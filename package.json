{
	"name": "unlinked-mentions-finder",
	"version": "0.0.7",
	"description": "Find unlinked mentions across an entire vault.",
	"main": "main.js",
	"scripts": {
		"dev": "vite build --mode=development --watch",
		"build": "vite build --mode=production",
		"tsc": "bun run typecheck",
		"test": "bun test",
		"test:log": "LOG_TESTS=true bun test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings=0 --report-unused-disable-directives",
		"lint:fix": "eslint . --fix --max-warnings=0 --report-unused-disable-directives",
		"svelte-check": "svelte-check --compiler-warnings \"unused-export-let:ignore\"",
		"check": "bun run format:check && bun run typecheck && bun run typecheck:tools && bun run svelte-check && bun run lint && bun run test",
		"release": "bun run release:prepare",
		"stats": "bun run automation/stats.ts",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint:review": "eslint . --config eslint.review.config.mjs",
		"verify": "bun run check && bun run build && lemons-automation validate",
		"release:prepare": "lemons-automation release:prepare",
		"package": "lemons-automation package",
		"typecheck:tools": "tsc --noEmit -p tsconfig.tools.json"
	},
	"keywords": [],
	"author": "Moritz Jung",
	"license": "GPL-3.0",
	"devDependencies": {
		"@happy-dom/global-registrator": "^18.0.1",
		"@tsconfig/svelte": "^5.0.4",
		"@types/bun": "1.3.14",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.25.5",
		"esbuild-plugin-copy-watch": "^2.3.1",
		"esbuild-svelte": "^0.9.3",
		"eslint": "9.39.4",
		"eslint-plugin-import": "^2.32.0",
		"obsidian": "latest",
		"prettier": "3.9.4",
		"prettier-plugin-svelte": "4.1.1",
		"string-argv": "^0.3.2",
		"svelte": "5.56.3",
		"svelte-check": "4.6.0",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.8.1",
		"typescript": "6.0.3",
		"@lemons_dev/lemons-obsidian-plugin-automation": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/automation-v0.2.4/automation-v0.2.4.tgz",
		"@lemons_dev/eslint-config-obsidian": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/eslint-config-v0.1.4/eslint-config-v0.1.4.tgz",
		"vite": "8.1.3",
		"@types/node": "25.5.0",
		"@sveltejs/vite-plugin-svelte": "7.1.2"
	},
	"packageManager": "bun@1.4.0",
	"overrides": {
		"typescript": "6.0.3",
		"typescript-eslint": "8.61.1"
	}
}
